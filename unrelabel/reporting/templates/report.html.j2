<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>unrelabel: Attack Report</title>
  <style>
    :root {
      --bg: #0d1117; --surface: #161b22; --border: #30363d;
      --accent: #58a6ff; --danger: #f85149; --success: #3fb950;
      --warning: #e3b341; --muted: #8b949e; --white: #f0f6fc;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--bg); color: var(--white); font-family: 'SF Mono', 'Cascadia Code', 'Fira Code', monospace; padding: 2rem; max-width: 1100px; margin: 0 auto; }
    h1 { color: var(--accent); font-size: 1.6rem; margin-bottom: 0.3rem; }
    h2 { color: var(--muted); border-bottom: 1px solid var(--border); padding-bottom: 0.4rem; margin: 1.5rem 0 0.8rem; font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.05em; }
    .subtitle { color: var(--muted); font-size: 0.85rem; margin-bottom: 1.5rem; }
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 1.4rem; margin: 0.8rem 0; }
    .score-card { text-align: center; padding: 2rem; }
    .score { font-size: 3.5rem; font-weight: bold; line-height: 1; }
    .score-sub { font-size: 1.2rem; color: var(--muted); }
    .severity-Clean    { color: var(--success); }
    .severity-Low      { color: var(--success); }
    .severity-Medium   { color: var(--warning); }
    .severity-High     { color: var(--danger); }
    .severity-Critical { color: var(--danger); font-weight: bold; }
    .severity-badge {
      display: inline-block; padding: 0.25rem 0.75rem; border-radius: 4px;
      font-size: 0.85rem; font-weight: 600; margin-top: 0.5rem;
    }
    .severity-badge.Clean, .severity-badge.Low { background: rgba(63,185,80,0.15); color: var(--success); border: 1px solid rgba(63,185,80,0.3); }
    .severity-badge.Medium { background: rgba(227,179,65,0.15); color: var(--warning); border: 1px solid rgba(227,179,65,0.3); }
    .severity-badge.High, .severity-badge.Critical { background: rgba(248,81,73,0.15); color: var(--danger); border: 1px solid rgba(248,81,73,0.3); }

    /* Metric grid */
    .metrics-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.8rem; margin: 1rem 0; }
    .metric { background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 1rem; text-align: center; }
    .metric .label { color: var(--muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; }
    .metric .value { font-size: 1.5rem; font-weight: bold; margin-top: 0.3rem; }
    .metric .delta { font-size: 0.8rem; margin-top: 0.2rem; }

    /* Tables */
    table { width: 100%; border-collapse: collapse; }
    th, td { padding: 0.6rem 1rem; text-align: left; border-bottom: 1px solid var(--border); }
    th { color: var(--muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; font-weight: 600; }
    td { font-size: 0.9rem; }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: rgba(88,166,255,0.04); }

    /* Confusion matrix */
    .cm-container { display: flex; gap: 2rem; flex-wrap: wrap; margin: 1rem 0; }
    .cm-wrapper { flex: 1; min-width: 280px; }
    .cm-wrapper h3 { color: var(--muted); font-size: 0.85rem; text-align: center; margin-bottom: 0.5rem; }
    .cm-table { width: 100%; }
    .cm-table th { text-align: center; font-size: 0.75rem; }
    .cm-table td { text-align: center; padding: 0.5rem; font-size: 0.85rem; font-weight: 600; border: 1px solid var(--border); }
    .cm-diag { background: rgba(63,185,80,0.12); }
    .cm-off { background: rgba(248,81,73,0.08); }

    img { max-width: 100%; border-radius: 6px; margin: 0.5rem 0; }

    /* Footer */
    .footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--border); color: var(--muted); font-size: 0.75rem; text-align: center; }
    .footer a { color: var(--accent); text-decoration: none; }
  </style>
</head>
<body>
  <h1>unrelabel: Attack Report</h1>
  <p class="subtitle">Generated: {{ result.timestamp }}</p>

  <!-- Vulnerability Score -->
  <div class="card score-card">
    <div class="score severity-{{ severity }}">{{ "%.1f"|format(result.vulnerability_score) }}</div>
    <div class="score-sub">/ 100</div>
    <div class="severity-badge {{ severity }}">{{ severity }}</div>
  </div>

  <!-- Key Metrics -->
  <h2>Key Metrics</h2>
  <div class="metrics-grid">
    <div class="metric">
      <div class="label">Attack Type</div>
      <div class="value" style="font-size:1.1rem">{{ result.attack_type }}</div>
    </div>
    <div class="metric">
      <div class="label">Clean Accuracy</div>
      <div class="value" style="color:var(--success)">{{ "%.2f%%"|format(result.clean_accuracy * 100) }}</div>
    </div>
    <div class="metric">
      <div class="label">Poisoned Accuracy</div>
      <div class="value" style="color:var(--warning)">{{ "%.2f%%"|format(result.poisoned_accuracy * 100) }}</div>
      <div class="delta" style="color:var(--danger)">↓ {{ "%.2f%%"|format(result.accuracy_drop * 100) }}</div>
    </div>
    {% if 'targeted_misclassification_rate' in result.config %}
    <div class="metric">
      <div class="label">Targeted Misclassification Rate</div>
      <div class="value" style="color:var(--danger)">{{ "%.4f"|format(result.config['targeted_misclassification_rate']) }}</div>
    </div>
    {% endif %}
    {% if 'attack_success' in result.config %}
    <div class="metric">
      <div class="label">Attack Succeeded</div>
      {% if result.config['attack_success'] %}
      <div class="value" style="color:var(--danger)">{{ result.config['attack_success'] }}</div>
      {% else %}
      <div class="value" style="color:var(--success)">{{ result.config['attack_success'] }}</div>
      {% endif %}
    </div>
    {% endif %}
    {% if result.flipped_indices is not none and result.flipped_indices|length > 0 %}
    <div class="metric">
      <div class="label">Labels Flipped</div>
      <div class="value">{{ result.flipped_indices|length }}</div>
    </div>
    {% endif %}
  </div>

  <!-- Attack Configuration -->
  <h2>Attack Configuration</h2>
  <div class="card">
    <table>
      {% for k, v in result.config.items() %}
      <tr><th>{{ k }}</th><td>{{ v }}</td></tr>
      {% endfor %}
    </table>
  </div>

  <!-- Confusion Matrices -->
  {% if result.confusion_matrices and 'clean' in result.confusion_matrices and 'poisoned' in result.confusion_matrices %}
  <h2>Confusion Matrices</h2>
  <div class="card">
    <div class="cm-container">
      {% for cm_name, cm_key in [('Clean Model', 'clean'), ('Poisoned Model', 'poisoned')] %}
      <div class="cm-wrapper">
        <h3>{{ cm_name }}</h3>
        <table class="cm-table">
          <tr>
            <th></th>
            {% for i in range(result.confusion_matrices[cm_key]|length) %}
            <th>Pred {{ i }}</th>
            {% endfor %}
          </tr>
          {% for row_idx in range(result.confusion_matrices[cm_key]|length) %}
          <tr>
            <th>True {{ row_idx }}</th>
            {% for col_idx in range(result.confusion_matrices[cm_key][row_idx]|length) %}
            <td class="{% if row_idx == col_idx %}cm-diag{% elif result.confusion_matrices[cm_key][row_idx][col_idx] > 0 %}cm-off{% endif %}">
              {{ result.confusion_matrices[cm_key][row_idx][col_idx] }}
            </td>
            {% endfor %}
          </tr>
          {% endfor %}
        </table>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <!-- Sweep Results -->
  {% if result.sweep_results %}
  {% set has_tmr = 'targeted_misclassification_rate' in result.sweep_results[0] %}
  <h2>Sweep Results</h2>
  <div class="card">
    <table>
      <tr>
        <th>Poison Rate</th>
        <th>Flipped</th>
        <th>Accuracy</th>
        <th>Drop</th>
        {% if has_tmr %}<th>Targeted Misclassification Rate</th>{% endif %}
        <th>Vuln Score</th>
        <th>Severity</th>
      </tr>
      {% for r in result.sweep_results %}
      <tr>
        <td>{{ "%.1f%%"|format(r.poison_rate * 100) }}</td>
        <td>{{ r.n_flipped|default('n/a') }}</td>
        <td>{{ "%.2f%%"|format(r.poisoned_accuracy * 100) }}</td>
        <td style="color:var(--danger)">{{ "%.2f%%"|format(r.accuracy_drop * 100) }}</td>
        {% if has_tmr %}<td style="color:var(--warning)">{{ "%.1f%%"|format(r.targeted_misclassification_rate * 100) }}</td>{% endif %}
        <td>{{ "%.1f"|format(r.vulnerability_score) }}</td>
        <td>
          {% set vs = r.vulnerability_score %}
          {% if vs <= 5 %}<span class="severity-badge Clean">Clean</span>
          {% elif vs <= 40 %}<span class="severity-badge Low">Low</span>
          {% elif vs <= 65 %}<span class="severity-badge Medium">Medium</span>
          {% elif vs <= 85 %}<span class="severity-badge High">High</span>
          {% else %}<span class="severity-badge Critical">Critical</span>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </table>
  </div>
  {% endif %}

  {% if inline_plots %}
  <h2>Visualizations</h2>
  <div class="card">
    {% for data_uri in inline_plots %}
    <img src="{{ data_uri }}" alt="plot"/>
    {% endfor %}
  </div>
  {% endif %}

  <div class="footer">
    Generated by <strong>unrelabel</strong>: Offensive ML Security Toolkit
  </div>
</body>
</html>
